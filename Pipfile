[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

# Runtime dependencies. These are the only ones bundled into the Lambda
# package (`pipenv requirements` emits just this section), so keep it minimal.
# boto3 is provided by the Lambda runtime and lives in dev-packages.
[packages]
icalendar = ">=7.3.0"
requests = ">=2.34.0"

[dev-packages]
boto3 = ">=1.43.0"
pytest = ">=9.1.0"
autopep8 = ">=2.3.2"
pylint = ">=4.0.0"

[requires]
python_version = "3.13"
